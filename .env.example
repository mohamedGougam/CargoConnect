# =============================================================================
# CargoConnect environment template
# Names and safe examples only — NEVER put real secrets in this file.
# Copy relevant lines into .env.local (gitignored).
# =============================================================================

# ---------------------------------------------------------------------------
# PUBLIC (browser-visible — NEXT_PUBLIC_* only)
# ---------------------------------------------------------------------------
# Client-visible mode (safe). Default: sample
# Options: sample | live | composite
NEXT_PUBLIC_MARITIME_DATA_MODE=sample

# Legacy alias still accepted by the client factory:
# NEXT_PUBLIC_DATA_PROVIDER=sample

# How often the browser polls /api/maritime/* in live|composite mode (ms)
NEXT_PUBLIC_MARITIME_POLL_INTERVAL_MS=10000

# Map style (no paid key required):
#   dark  — built-in ESRI Dark Gray (recommended)
#   ocean — built-in ESRI World Ocean
#   or a full MapLibre style URL
NEXT_PUBLIC_MAP_STYLE_URL=dark

# Optional MapTiler / other tile key when you switch providers later
# NEXT_PUBLIC_MAP_API_KEY=

# ---------------------------------------------------------------------------
# DEMO (presentation / walkthrough — PostgreSQL intentionally deferred)
# ---------------------------------------------------------------------------
# See docs/DEMO_ACTIVATION.md
#
# Commercial persistence: only memory | postgres exist in code.
# Demo uses in-memory repositories (no active JSON file store).
DEMO_MODE=true
COMMERCIAL_STORE=memory
# Do NOT set DATABASE_URL or COMMERCIAL_PERSISTENCE=postgres for demo.
#
# Malware — DEMO ONLY bypass (not real protection):
MALWARE_SCAN_PROVIDER=noop
MALWARE_SCAN_ALLOW_NOOP=true
#
# AIS remains development/demo until licensed rights confirmed:
AIS_PROVIDER_MODE=development
#
# Safe email (no external send):
EMAIL_DELIVERY_MODE=log
EMAIL_PROVIDER=resend
#
# Rate limits on Upstash (after Redis validated):
# RATE_LIMIT_PROVIDER=redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Optional demo reset (HTTP): DEMO_RESET_SECRET= (≥16 chars, never NEXT_PUBLIC_)
# DEMO_RESET_SECRET=
# ---------------------------------------------------------------------------
# SERVER ONLY — never use NEXT_PUBLIC_ for these
# ---------------------------------------------------------------------------

# Server mode (controls AIS ingest). Keep in sync with NEXT_PUBLIC_MARITIME_DATA_MODE
# when testing live/composite.
MARITIME_DATA_MODE=sample

# Master switch for AISStream prototype ingest (default off)
AISSTREAM_ENABLED=false

# Free AISStream API key — SERVER ONLY. Do not commit real keys.
# Obtain at https://aisstream.io/ (sign in with GitHub → Account → create API key)
# DEVELOPMENT / PROTOTYPE use only. Commercial/public-display rights are NOT confirmed.
# AISSTREAM_API_KEY=

# Optional JSON bounding boxes (AISStream corner pairs [[swLat,swLon],[neLat,neLon]], ...)
# Default Eastern Mediterranean — Greece, Aegean, Crete, western Turkey, Cyprus approaches
# Lat 30.0–41.5, Lon 22.0–37.0
# AISSTREAM_BBOXES=[[[30.0,22.0],[41.5,37.0]]]

# Allow /api/maritime/diagnostics outside development (default: off in production)
# MARITIME_DIAGNOSTICS_ENABLED=false

# ---------------------------------------------------------------------------
# LIVE PROTOTYPE CHECKLIST (copy into .env.local — never commit secrets)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_MARITIME_DATA_MODE=composite
# MARITIME_DATA_MODE=composite
# AISSTREAM_ENABLED=true
# AISSTREAM_API_KEY=paste_your_key_here
# NEXT_PUBLIC_MAP_STYLE_URL=dark
# NEXT_PUBLIC_MARITIME_POLL_INTERVAL_MS=10000

# ---------------------------------------------------------------------------
# COMMERCIAL AUTH + REQUEST PERSISTENCE (server only)
# ---------------------------------------------------------------------------
# Required in production (min 32 characters). Signs session cookies.
# AUTH_SECRET=

# Demo / tests: in-memory commercial repositories (default without DATABASE_URL).
# COMMERCIAL_STORE=memory
# DEMO_MODE=true

# COMMERCIAL_DATA_DIR is unused — JSON file commercial store was removed.
# Do not rely on local disk for commercial records on Render (ephemeral).

# ---------------------------------------------------------------------------
# POSTGRES (CONTROLLED PILOT GATE — deferred for current demo)
# ---------------------------------------------------------------------------
# Do not set for presentation demo. When enabling pilot:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/cargoconnect
# COMMERCIAL_PERSISTENCE=postgres
# Then: backups → npm run db:migrate → npm run db:status
# Keep migrations through 0012; do not delete drizzle/ or db scripts.
# ---------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Resend) — server only, never NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# EMAIL_DELIVERY_MODE=log
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=requests@your-verified-domain
# EMAIL_FROM_NAME=CargoConnect
# EMAIL_REPLY_TO_OVERRIDE=

# ---------------------------------------------------------------------------
# INBOUND EMAIL (Resend receiving) — server only
# ---------------------------------------------------------------------------
# EMAIL_INBOUND_ENABLED=false
# EMAIL_INBOUND_PROVIDER=resend
# EMAIL_INBOUND_DOMAIN=reply.your-domain.com
# EMAIL_WEBHOOK_SECRET=whsec_...
# Legacy alias also accepted: RESEND_WEBHOOK_SECRET=
# Domain alias also accepted: EMAIL_REPLY_DOMAIN=
# Dev fixture endpoint (never in production):
# EMAIL_INBOUND_DEV_FIXTURES=false

# Optional FX for quote comparison (never fabricate rates)
# FX_ENABLED=false
# FX_RATES_JSON={"EUR":1.1,"GBP":1.27,"USD":1}
# FX_RATES_AS_OF=2026-09-10T00:00:00.000Z
# FX_SOURCE=manual_config

# ---------------------------------------------------------------------------
# EMAIL VERIFICATION (server only)
# ---------------------------------------------------------------------------
# Public origin used in verification links (no trailing slash).
# Production example: https://your-app.onrender.com
# APP_BASE_URL=http://localhost:3000
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
# Cooldown between resend requests (seconds). Tests may set 0.
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# DOCUMENT STORAGE (server only — never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# local (dev/tests) or s3 (AWS S3 / Cloudflare R2 / MinIO-compatible)
# DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_LOCAL_DIR=.data/documents
# DOCUMENT_MAX_FILE_SIZE_MB=15
#
# Production S3-compatible (private bucket required):
# DOCUMENT_STORAGE_PROVIDER=s3
# DOCUMENT_STORAGE_BUCKET=your-private-bucket
# DOCUMENT_STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# DOCUMENT_STORAGE_REGION=auto
# DOCUMENT_STORAGE_ACCESS_KEY=
# DOCUMENT_STORAGE_SECRET_KEY=
# DOCUMENT_STORAGE_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# SHIPMENT EXECUTION / AIS OBSERVATION (server only)
# ---------------------------------------------------------------------------
# SHIPMENT_GEOFENCE_RADIUS_KM=40
# SHIPMENT_OBSERVATION_MAX_PER_EXECUTION=200
# SHIPMENT_OBSERVATION_PERIODIC_MS=1800000
# AIS_FRESHNESS_RECENT_MS=900000
# AIS_FRESHNESS_DELAYED_MS=3600000
# Enable AIS fixture POST in production only if needed for demos:
# SHIPMENT_AIS_FIXTURES=false
#
# Server-side observation watcher (Render cron / Vercel cron / worker).
# Never expose with NEXT_PUBLIC_. Browser polling is display-only.
# SHIPMENT_OBSERVATION_JOB_SECRET=
# SHIPMENT_OBSERVATION_INTERVAL_SECONDS=300
# Cron validate helper (optional):
# CRON_VALIDATE_BASE_URL=https://your-app.onrender.com
# CRON_TARGET_URL=https://your-app.onrender.com/api/internal/shipment-observation/run
#
# Operational exception thresholds (server only):
# SHIPMENT_EXCEPTION_AIS_STALE_MINUTES=60
# SHIPMENT_EXCEPTION_ETA_SLIPPAGE_MINUTES=360
# SHIPMENT_EXCEPTION_ROUTE_DEVIATION_KM=80
# SHIPMENT_ROUTE_DEVIATION_KM=80
# SHIPMENT_EXCEPTION_ORIGIN_DWELL_HOURS=12
# SHIPMENT_EXCEPTION_DESTINATION_DWELL_HOURS=12
# SHIPMENT_EXCEPTION_MILESTONE_GRACE_MINUTES=120

# ---------------------------------------------------------------------------
# OPTIONAL / PRODUCTION HARDENING (server only)
# ---------------------------------------------------------------------------
# RATE_LIMIT_PROVIDER=memory
# For Upstash REST or REDIS_URL, set:
# RATE_LIMIT_PROVIDER=redis
# (Do NOT use RATE_LIMIT_PROVIDER=upstash — the value is "redis"; Upstash is auto-selected
#  when UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN are present.)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=redis://...
#
# INTERNAL_OPS_SECRET=          # optional bearer for ready metrics
# TRUSTED_ORIGINS=https://your-app.example
# SENTRY_DSN=                   # optional; logs remain sufficient without it
#
# DB_POOL_MAX=5
# DB_IDLE_TIMEOUT_SECONDS=20
# DB_CONNECT_TIMEOUT_SECONDS=10
#
# ORPHAN_MAX_AGE_HOURS=24
# ORPHAN_CLEANUP_APPLY=false

# ---------------------------------------------------------------------------
# PRE-PRODUCTION REQUIRED (before real pilot — not demo blockers)
# ---------------------------------------------------------------------------
# 1) Real malware scanner (deploy services/malware-scanner/ first):
# MALWARE_SCAN_PROVIDER=http
# MALWARE_SCAN_URL=https://scanner.example/scan
# MALWARE_SCAN_HEALTH_URL=https://scanner.example/health
# MALWARE_SCAN_SECRET=
# Remove MALWARE_SCAN_ALLOW_NOOP (do not leave true in production)
# MALWARE_SCAN_ALLOW_NOOP=false
# Optional hard gate: MALWARE_SCAN_REQUIRE_REAL=true
#
# 2) Live email + inbound (verified Resend domain + webhook):
# EMAIL_DELIVERY_MODE=live
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=requests@your-verified-domain
# EMAIL_INBOUND_ENABLED=true
# EMAIL_INBOUND_DOMAIN=reply.your-domain.com
# EMAIL_WEBHOOK_SECRET=whsec_...
# APP_BASE_URL=https://your-app.onrender.com
#
# 3) Licensed AIS (only after written commercial rights):
# AIS_PROVIDER_MODE=licensed
#
# 4) Observation cron secret + Render Cron Job (every 5 minutes)
# SHIPMENT_OBSERVATION_JOB_SECRET=
