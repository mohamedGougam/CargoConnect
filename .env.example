# Client-visible mode (safe). Default: sample
# Options: sample | live | composite
NEXT_PUBLIC_MARITIME_DATA_MODE=sample

# Legacy alias still accepted by the client factory:
# NEXT_PUBLIC_DATA_PROVIDER=sample

# How often the browser polls /api/maritime/* in live|composite mode (ms)
NEXT_PUBLIC_MARITIME_POLL_INTERVAL_MS=10000

# Map style (no paid key required):
#   dark  → built-in ESRI Dark Gray (recommended)
#   ocean → built-in ESRI World Ocean
#   or a full MapLibre style URL
NEXT_PUBLIC_MAP_STYLE_URL=dark

# Optional MapTiler / other tile key when you switch providers later
# NEXT_PUBLIC_MAP_API_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY — never use NEXT_PUBLIC_ for these
# ---------------------------------------------------------------------------

# Server mode (controls AIS ingest). Keep in sync with NEXT_PUBLIC_MARITIME_DATA_MODE
# when testing live/composite.
MARITIME_DATA_MODE=sample

# Master switch for AISStream prototype ingest (default off)
AISSTREAM_ENABLED=false

# Free AISStream API key — SERVER ONLY. Do not commit real keys.
# Obtain at https://aisstream.io/ (sign in with GitHub → Account → create API key)
# DEVELOPMENT / PROTOTYPE use only. Commercial/public-display rights are NOT confirmed.
# AISSTREAM_API_KEY=

# Optional JSON bounding boxes (AISStream corner pairs [[swLat,swLon],[neLat,neLon]], ...)
# Default Eastern Mediterranean ≈ Greece, Aegean, Crete, western Turkey, Cyprus approaches
# Lat 30.0–41.5, Lon 22.0–37.0
# AISSTREAM_BBOXES=[[[30.0,22.0],[41.5,37.0]]]

# Allow /api/maritime/diagnostics outside development (default: off in production)
# MARITIME_DIAGNOSTICS_ENABLED=false

# ---------------------------------------------------------------------------
# LIVE PROTOTYPE CHECKLIST (copy into .env.local — never commit secrets)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_MARITIME_DATA_MODE=composite
# MARITIME_DATA_MODE=composite
# AISSTREAM_ENABLED=true
# AISSTREAM_API_KEY=paste_your_key_here
# NEXT_PUBLIC_MAP_STYLE_URL=dark
# NEXT_PUBLIC_MARITIME_POLL_INTERVAL_MS=10000
